<p><a href="{{ action_url }}">{% include "frag." ~ locale ~ ".password_reset.action" %}</a></p>
<p>{% include "frag." ~ locale ~ ".password_reset.expiry" %}</p>
<p>{% include "frag." ~ locale ~ ".common.ignore" %}</p>
{% endblock %}
